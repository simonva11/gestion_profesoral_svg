# =====================================================================
#  VARIABLES DE ENTORNO — copie este archivo a .env y ponga los valores
#  reales ahí.
#
#  El .env NUNCA se sube: está en el .gitignore desde el primer commit.
#  Este .env.example SÍ se sube, con valores de mentira, para que cualquier
#  integrante (o el profesor) sepa qué hay que configurar.
#
#  Un secreto escrito en el código anula el criterio de seguridad de la
#  versión (0_METODOLOGIA.md §6).
# =====================================================================

# Contraseña del usuario sa de SQL Server. La REAL no va aquí.
SA_PASSWORD=CambieEstaClave123!

# Cadena de conexión que lee la API. Dentro de Docker el servidor es el
# NOMBRE del servicio del compose (sqlserver), no localhost: localhost
# dentro de un contenedor es el contenedor mismo.
ConnectionStrings__SqlServer=Server=sqlserver,1433;Database=gestion_local;User Id=sa;Password=CambieEstaClave123!;TrustServerCertificate=True;

# Dirección de la API que usa el front. Mismo motivo: el nombre del servicio.
UrlApi=http://api-gestion:8074
