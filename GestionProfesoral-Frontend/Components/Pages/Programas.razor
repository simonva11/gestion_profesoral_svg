@page "/programas"
@rendermode InteractiveServer
@inject ServicioPrograma Servicio
@inject IJSRuntime JS

@*
    ==================================================================
    LA PANTALLA DE `programa`
    ==================================================================

    Tiene DIRECCIÓN PROPIA —/programas—, no una con el nombre de la tabla como
    parámetro. Se puede guardar como marcador, mandar por correo y poner en un
    menú (Artículo 10.1).

    Y no le habla al usuario en jerga: aquí no aparece «PUT», ni «422», ni
    «programa». Los dos botones de guardar se llaman como el usuario
    piensa; que uno mande un reemplazo y el otro una modificación parcial es
    asunto del programa.
*@

<PageTitle>Programas</PageTitle>

<div class="encabezado">
    <div>
        <h1>Programas</h1>
        <p class="nota">
            Los programas académicos de la Universidad. Un programa retirado deja de aparecer aquí, pero no se borra: los docentes que quedaron adscritos a él se conservan.
        </p>
    </div>
    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@* ─────────── LOS AVISOS ─────────── *@
@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@* ─────────── EL FORMULARIO ─────────── *@
@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar el programa" : "Agregar el programa")</h2>

        <label>
            Código
            <input type="number" @bind="campoId" disabled="@editando" />
            @if (editando)
            {
                <span class="ayuda">
                    El código identifica la ficha y no se cambia. Si está mal, se agrega otra y se retira esta.
                </span>
            }
            else
            {
                <span class="ayuda">
                    El código del programa, como 10101. No se podrá cambiar después.
                </span>
            }
        </label>

        <label>
            Nombre
            <input type="text" maxlength="60" @bind="campoNombre" />
        </label>

        <label>
            Tipo
            <input type="text" maxlength="45" @bind="campoTipo" />
        </label>

        <label>
            Nivel
            <input type="text" maxlength="45" @bind="campoNivel" />
        </label>

        <label>
            Fecha de creación
            <input type="text" maxlength="45" @bind="campoFechaCreacion" />
            <span class="ayuda">Es texto en el esquema dado, no una fecha.</span>
        </label>

        <label>
            Fecha de cierre
            <input type="text" maxlength="45" @bind="campoFechaCierre" />
            <span class="ayuda">Déjela en blanco si el programa sigue abierto.</span>
        </label>

        <label>
            Número de cohortes
            <input type="text" maxlength="45" @bind="campoNumeroCohortes" />
        </label>

        <label>
            Cantidad de graduados
            <input type="text" maxlength="45" @bind="campoCantGraduados" />
        </label>

        <label>
            Fecha de actualización
            <input type="text" maxlength="45" @bind="campoFechaActualizacion" />
        </label>

        <label>
            Ciudad
            <input type="text" maxlength="45" @bind="campoCiudad" />
        </label>

        <label>
            Facultad
            <input type="number" @bind="campoFacultad" />
        </label>

        @*
            ==============================================================
            LOS DOS BOTONES, QUE NO HACEN LO MISMO

              · «Guardar la ficha completa» manda todo, así que un dato
                obligatorio en blanco se rechaza.
              · «Guardar solo lo que cambié» manda únicamente lo diligenciado,
                así que el mismo formulario a medio llenar sí se guarda.

            El mismo formulario, dos comportamientos, y la diferencia no la
            decide ningún `if` de negocio: la decide QUÉ SE ENVÍA.
            ==============================================================
        *@
        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario" @onclick="GuardarCompleta" disabled="@guardando">
                    Guardar la ficha completa
                </button>
                <button class="boton" @onclick="GuardarLoQueCambio" disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario" @onclick="Crear" disabled="@guardando">
                    Agregar
                </button>
            }
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        @if (editando)
        {
            <span class="ayuda">
                «La ficha completa» exige que los 9 datos obligatorios estén
                diligenciados. «Solo lo que cambié» guarda lo que usted escribió
                y deja lo demás como estaba.
            </span>
        }
    </div>
}

@* ─────────── EL LISTADO ─────────── *@
@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Nivel</th>
                    <th>Ciudad</th>
                    <th>Facultad</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td><code>@fila.Id</code></td>
                        <td>@fila.Nombre</td>
                        <td>@fila.Tipo</td>
                        <td>@fila.Nivel</td>
                        <td>@fila.Ciudad</td>
                        <td>@fila.Facultad</td>
                        <td>
                            <div class="acciones">
                                <button class="boton" @onclick="() => Editar(fila)">Editar</button>
                                <button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count ficha(s).</p>
}
else
{
    @* Vacío NO es un error, y la pantalla lo distingue: si la API está caída,
       arriba hay además un aviso rojo. *@
    <p class="vacio">
        Todavía no hay programas. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<Programa> filas = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;

    private int campoId;
    private string campoNombre = string.Empty;
    private string campoTipo = string.Empty;
    private string campoNivel = string.Empty;
    private string campoFechaCreacion = string.Empty;
    private string campoFechaCierre = string.Empty;
    private string campoNumeroCohortes = string.Empty;
    private string campoCantGraduados = string.Empty;
    private string campoFechaActualizacion = string.Empty;
    private string campoCiudad = string.Empty;
    private int campoFacultad;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        // Aun con error se pinta la pantalla: el usuario ve el aviso DENTRO de
        // la aplicación, no una página de excepción.
        errores = r.Errores;
        filas = r.Ok ? r.Datos! : new();
    }

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(Programa fila)
    {
        campoId = fila.Id;
        campoNombre = fila.Nombre;
        campoTipo = fila.Tipo;
        campoNivel = fila.Nivel;
        campoFechaCreacion = fila.FechaCreacion;
        campoFechaCierre = fila.FechaCierre ?? string.Empty;
        campoNumeroCohortes = fila.NumeroCohortes;
        campoCantGraduados = fila.CantGraduados;
        campoFechaActualizacion = fila.FechaActualizacion;
        campoCiudad = fila.Ciudad;
        campoFacultad = fila.Facultad;
        editando = true;
        mostrandoFormulario = true;
        errores = new();
        exito = string.Empty;
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoId = 0;
        campoNombre = string.Empty;
        campoTipo = string.Empty;
        campoNivel = string.Empty;
        campoFechaCreacion = string.Empty;
        campoFechaCierre = string.Empty;
        campoNumeroCohortes = string.Empty;
        campoCantGraduados = string.Empty;
        campoFechaActualizacion = string.Empty;
        campoCiudad = string.Empty;
        campoFacultad = 0;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(new Programa
        {
            Id = campoId,
            Nombre = campoNombre.Trim(),
            Tipo = campoTipo.Trim(),
            Nivel = campoNivel.Trim(),
            FechaCreacion = campoFechaCreacion.Trim(),
            FechaCierre = string.IsNullOrWhiteSpace(campoFechaCierre)
                ? null
                : campoFechaCierre.Trim(),
            NumeroCohortes = campoNumeroCohortes.Trim(),
            CantGraduados = campoCantGraduados.Trim(),
            FechaActualizacion = campoFechaActualizacion.Trim(),
            Ciudad = campoCiudad.Trim(),
            Facultad = campoFacultad,
        });
        guardando = false;

        await TrasGuardar(r, $"Se agregó el programa {campoId}.");
    }

    private async Task GuardarCompleta()
    {
        guardando = true;
        var r = await Servicio.Reemplazar(campoId, new Programa
        {
            Nombre = campoNombre.Trim(),
            Tipo = campoTipo.Trim(),
            Nivel = campoNivel.Trim(),
            FechaCreacion = campoFechaCreacion.Trim(),
            FechaCierre = string.IsNullOrWhiteSpace(campoFechaCierre)
                ? null
                : campoFechaCierre.Trim(),
            NumeroCohortes = campoNumeroCohortes.Trim(),
            CantGraduados = campoCantGraduados.Trim(),
            FechaActualizacion = campoFechaActualizacion.Trim(),
            Ciudad = campoCiudad.Trim(),
            Facultad = campoFacultad,
        });
        guardando = false;

        await TrasGuardar(r, $"Se guardó el programa {campoId}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;
        var r = await Servicio.Actualizar(
            campoId,
            campoNombre,
            campoTipo,
            campoNivel,
            campoFechaCreacion,
            campoFechaCierre,
            campoNumeroCohortes,
            campoCantGraduados,
            campoFechaActualizacion,
            campoCiudad,
            campoFacultad == 0 ? null : campoFacultad);
        guardando = false;

        await TrasGuardar(r, $"Se guardó el programa {campoId}.");
    }

    /// <summary>
    /// Lo que pasa después de cualquier guardado: si salió bien se cierra el
    /// formulario y se recarga; si no, **el formulario se queda con lo que la
    /// persona había escrito**, porque perder lo digitado por un error de
    /// validación es castigarla dos veces.
    /// </summary>
    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(Programa fila)
    {
        // Se pregunta antes: retirar no se deshace desde esta pantalla.
        var seguro = await JS.InvokeAsync<bool>(
            "confirm", $"¿Retirar {fila.Id} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Id);
        if (r.Ok)
        {
            exito = $"Se retiró el programa {fila.Id}.";
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
